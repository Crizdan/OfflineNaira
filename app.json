{
  "expo": {
    "name": "offline",
    "slug": "offline",
    "version": "1.0.0",
    "scheme": "offline-naira",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Offline Naira uses Bluetooth to send and receive payments with nearby phones when there's no internet connection."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E14"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.crizdan77.offline"
    },
    "permissions": [
      "android.permission.BLUETOOTH_SCAN",
      "android.permission.BLUETOOTH_ADVERTISE",
      "android.permission.BLUETOOTH_CONNECT",
      "android.permission.ACCESS_FINE_LOCATION",
      "android.permission.BLUETOOTH",
      "android.permission.BLUETOOTH_ADMIN"
    ],
    "package": "com.crizdan77.offline",
    "extra": {
      "eas": {
        "projectId": "71d44ecb-5713-4533-9247-c77b47885cd8"
      }
    }
  },
  "web": {
    "favicon": "./assets/favicon.png",
    "bundler": "metro"
  },
  "plugins": [
    "expo-router",
    "expo-sqlite",
    "expo-secure-store",
    [
      "react-native-ble-plx",
      {
        "isBackgroundEnabled": false,
        "modes": [
          "peripheral",
          "central"
        ],
        "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to nearby phones over Bluetooth"
      }
    ]
  ],
  "extra": {
    "router": {},
    "eas": {
      "projectId": "71d44ecb-5713-4533-9247-c77b47885cd8"
    }
  }
}
